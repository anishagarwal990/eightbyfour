# Copy to .env.local (app runtime) / .env (scripts) and fill in real values.
# Never commit real values — this file documents names and purpose only.

# --- Supabase (app runtime — public, RLS-protected) ------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (scripts only — run by a human at a terminal, never in the
#     deployed app; see lib/supabase/admin-server.ts) -----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Cloudflare (image delivery) --------------------------------------------
CF_TOKEN=
CF_ACCOUNT_ID=

# --- Analytics (client-side pixels only — see lib/analytics.ts,
#     components/MarketingTracking.tsx) -------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Growth Command Center integrations (none of these are wired yet —
#     see supabase/growth-schema.sql's growth_integrations seed rows and
#     /admin/growth/analytics for live status. Adding a key here does not
#     connect anything by itself; each needs its own adapter code, not
#     written yet, per the brief's "don't pretend an integration exists"
#     instruction) --------------------------------------------------------
